class Employee:

    def __init__(self, employee_id, name, age, email, phone,
                 department, salary):

        self.employee_id = employee_id
        self.name = name
        self.age = age
        self.email = email
        self.phone = phone
        self.department = department

        # Private salary - Encapsulation
        self.__salary = salary
        self.bonus = 0
        self.attendance = []

        def display_details(self):

        print("Employee ID :", self.employee_id)
        print("Name        :", self.name)
        print("Age         :", self.age)
        print("Email       :", self.email)
        print("Phone       :", self.phone)
        print("Department  :", self.department)

        #update detals---

def update_details(self, name=None, age=None,
                       email=None, phone=None, department=None):

        if name:
            self.name = name

        if age:
            self.age = age

        if email:
            self.email = email

        if phone:
            self.phone = phone

        if department:
            self.department = department

        print("Employee details updated successfully.")
